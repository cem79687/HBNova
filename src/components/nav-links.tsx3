"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";

const links = [
  { href: "/", label: "Tableau de bord", short: "Accueil", icon: "dashboard" },
  { href: "/chantiers", label: "Chantiers", short: "Chantiers", icon: "chantiers" },
  { href: "/clients", label: "Clients", short: "Clients", icon: "clients" },
  { href: "/devis", label: "Devis", short: "Devis", icon: "devis" },
  { href: "/factures", label: "Factures", short: "Factures", icon: "factures" },
] as const;

type IconName = (typeof links)[number]["icon"];

function Icon({ name }: { name: IconName }) {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-[18px] w-[18px] shrink-0"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      {name === "dashboard" && (
        <>
          <rect x="3" y="3" width="7" height="9" rx="1" />
          <rect x="14" y="3" width="7" height="5" rx="1" />
          <rect x="14" y="12" width="7" height="9" rx="1" />
          <rect x="3" y="16" width="7" height="5" rx="1" />
        </>
      )}
      {name === "chantiers" && (
        <>
          <path d="M3 21h18M5 21V10l7-6 7 6v11" />
          <path d="M10 21v-6h4v6" />
        </>
      )}
      {name === "clients" && (
        <>
          <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" />
          <circle cx="10" cy="7" r="4" />
          <path d="M21 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" />
        </>
      )}
      {name === "devis" && (
        <>
          <path d="M6 3h9l4 4v14H6z" />
          <path d="M14 3v5h5M9 13h6M9 17h6" />
        </>
      )}
      {name === "factures" && (
        <>
          <path d="M6 2h12v20l-3-2-3 2-3-2-3 2z" />
          <path d="M9 7h6M9 11h6M9 15h4" />
        </>
      )}
    </svg>
  );
}

export default function NavLinks({ variant }: { variant: "side" | "bottom" }) {
  const pathname = usePathname();

  return (
    <ul
      className={
        variant === "side"
          ? "flex flex-col gap-1"
          : "flex justify-around pb-[env(safe-area-inset-bottom)]"
      }
    >
      {links.map((link) => {
        const active =
          link.href === "/" ? pathname === "/" : pathname.startsWith(link.href);

        const base =
          variant === "side"
            ? "flex items-center gap-3 rounded-md px-3 py-2.5 font-medium"
            : "flex flex-1 flex-col items-center gap-0.5 px-1 py-2 text-center text-[11px] font-medium";
        const state = active
          ? variant === "side"
            ? "bg-brand/20 text-white shadow-[inset_3px_0_0_var(--brand)]"
            : "text-white shadow-[inset_0_3px_0_var(--brand)]"
          : "text-white/70 hover:bg-white/10 hover:text-white";

        return (
          <li key={link.href} className={variant === "bottom" ? "flex-1" : ""}>
            <Link
              href={link.href}
              aria-current={active ? "page" : undefined}
              className={`${base} ${state}`}
            >
              <Icon name={link.icon} />
              {variant === "side" ? link.label : link.short}
            </Link>
          </li>
        );
      })}
    </ul>
  );
}
